server {
  listen 80;
  server_name _;
  root /usr/share/nginx/html;
  index index.html;
  client_max_body_size 4m;   # doctor photo upload limit is 3 MB

  add_header X-Content-Type-Options nosniff always;
  add_header X-Frame-Options DENY always;
  add_header Referrer-Policy strict-origin-when-cross-origin always;

  # API, health checks and uploaded photos go to the backend container
  location ~ ^/(api|health|ready|uploads)(/|$) {
    # Variable + resolver: nginx re-resolves "backend" so API restarts/redeploys never leave a stale IP behind.
    resolver ${NGINX_RESOLVER} valid=10s;
    set $api ${API_UPSTREAM};
    proxy_pass $api;
    proxy_set_header Host $host;
    proxy_set_header X-Real-IP $remote_addr;
    proxy_set_header X-Forwarded-For $proxy_add_x_forwarded_for;
    proxy_set_header X-Forwarded-Proto $scheme;
    proxy_set_header X-Request-ID $request_id;
  }

  # Vite assets are content-hashed
  location /assets/ { expires 30d; add_header Cache-Control "public, immutable"; try_files $uri =404; }

  # Single-page app fallback
  location / { try_files $uri /index.html; }
}
