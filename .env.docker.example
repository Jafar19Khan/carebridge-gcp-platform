# Copy to ".env" next to docker-compose.yml and change every value. Never commit .env.
DB_NAME=carebridge
DB_USER=carebridge
DB_PASSWORD=change_me_db_password
DB_ROOT_PASSWORD=change_me_root_password
# node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
JWT_SECRET=replace-with-a-random-secret-at-least-32-characters-long
CORS_ORIGIN=http://localhost:8080
WEB_PORT=8080
PAYMENT_MODE=local
SEED_INITIAL_DATA=true
BOOTSTRAP_ADMIN_EMAIL=admin@carebridge.local
BOOTSTRAP_ADMIN_PASSWORD=ChangeMe_Admin_123!
BOOTSTRAP_PATIENT_PASSWORD=ChangeMe_Patient_123!
BOOTSTRAP_DOCTOR_PASSWORD=ChangeMe_Doctor_123!
